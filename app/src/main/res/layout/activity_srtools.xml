<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"

    android:id="@+id/srtoolsRoot"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="@color/app_background"

    tools:context=".SRToolsActivity">

    <!-- ================================================= -->
    <!-- WebView -->
    <!-- 始终占满整个 Activity -->
    <!-- ================================================= -->

    <WebView
        android:id="@+id/webView"

        android:layout_width="match_parent"
        android:layout_height="match_parent"

        android:background="@color/app_background"

        android:overScrollMode="never"

        android:scrollbars="none"

        android:fadingEdge="none" />


    <!-- ================================================= -->
    <!-- Loading -->
    <!-- ================================================= -->

    <ProgressBar
        android:id="@+id/progressBar"

        android:layout_width="44dp"
        android:layout_height="44dp"

        android:layout_gravity="center"

        android:visibility="gone"
        android:indeterminateTint="@color/accent"
        android:contentDescription="@string/srtools_loading" />


    <LinearLayout
        android:id="@+id/srtoolsToolbar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_srtools_toolbar"
        android:elevation="10dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="4dp">

        <TextView
            android:id="@+id/toolbarDragHandle"
            android:layout_width="24dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="⋮⋮"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:contentDescription="@string/srtools_drag" />

        <Button
            android:id="@+id/orientationButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_srtools_tool_button"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="@string/srtools_orientation_portrait"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:contentDescription="@string/srtools_toggle_orientation" />

        <Button
            android:id="@+id/reloadButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="2dp"
            android:background="@drawable/bg_srtools_tool_button"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="@string/srtools_reload_short"
            android:textColor="@color/text_primary"
            android:textSize="23sp"
            android:contentDescription="@string/srtools_reload" />

        <Button
            android:id="@+id/closeButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="2dp"
            android:background="@drawable/bg_srtools_close_button"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="@string/srtools_close_short"
            android:textColor="@color/text_primary"
            android:textSize="25sp"
            android:contentDescription="@string/srtools_close" />

        <Button
            android:id="@+id/hideToolbarButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="2dp"
            android:background="@drawable/bg_srtools_tool_button"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="@string/srtools_hide_short"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:contentDescription="@string/srtools_hide" />
    </LinearLayout>

    <Button
        android:id="@+id/showToolbarButton"
        android:layout_width="56dp"
        android:layout_height="40dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_start_button"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:padding="0dp"
        android:text="@string/srtools_enable_short"
        android:textColor="@color/text_on_accent"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone"
        android:contentDescription="@string/srtools_enable" />

</FrameLayout>
