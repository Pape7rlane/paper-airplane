<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="@drawable/bg_security_dialog"
    android:paddingLeft="26dp"
    android:paddingRight="26dp"
    android:paddingTop="24dp"
    android:paddingBottom="24dp">

    <ImageView
        android:layout_width="76dp"
        android:layout_height="76dp"
        android:src="@drawable/ic_security_warning"
        android:contentDescription="警告" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="安全警告"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:gravity="center"
        android:lineSpacingExtra="5dp"
        android:text="该应用完全免费，群1109503417"
        android:textColor="#F4F4F5"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/securityWarningButton"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="28dp"
        android:gravity="center"
        android:background="@drawable/bg_security_button"
        android:clickable="true"
        android:focusable="true"
        android:text="我已知晓"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold" />
</LinearLayout>
